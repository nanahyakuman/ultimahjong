; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ULTIMAHJONG"
run/main_scene="res://main_menu.tscn"
config/features=PackedStringArray("4.0", "Forward Plus")
boot_splash/bg_color=Color(0.266667, 0.466667, 0.4, 1)
boot_splash/image="res://image/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=false

[autoload]

FuncKeys="*res://global/FuncKeys.gd"
TileGraphicKnower="*res://global/TileGraphicKnower.gd"
COL="*res://global/Colors.gd"
CursorText="*res://global/cursor_text.tscn"
MusicManager="*res://global/MusicManager.tscn"
AnimTimer="*res://AnimTimer.gd"
LocaleChangedSignaller="*res://global/LocaleChangedSignaller.gd"
CharInfoForwarder="*res://global/CharInfoForwarder.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=4
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[input]

fullscreen={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194342,"key_label":0,"unicode":0,"echo":false,"script":null)
]
}
screenshot={
"deadzone": 0.5,
"events": []
}
set_size={
"deadzone": 0.5,
"events": []
}
start_shop={
"deadzone": 0.5,
"events": []
}

[internationalization]

locale/translation_remaps={}
locale/translations=PackedStringArray("res://text/MAHJONG_TRANSLATIONS.en.translation", "res://text/MAHJONG_TRANSLATIONS.ja.translation")

[rendering]

environment/defaults/default_clear_color=Color(0.266667, 0.466667, 0.4, 1)
textures/canvas_textures/default_texture_filter=0
