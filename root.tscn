text = "[b]Special[/b]
Assorted Fu awards.
Base: 20
Closed Ron: 10
Win by tsumo: 2
Chiitoitsu: exactly 25

[b]Dora[/b]
[table=2]
[cell]Aka Dora[/cell][cell]16[/cell]
[cell]Kan Dora[/cell][cell]16[/cell]
[cell]Ura Dora[/cell][cell]16[/cell]
[/table]

[b]Grouping[/b]
Fu awarded for each grouping in your hand.
[table=3]
[cell]Type[/cell][cell]Normal[/cell][cell]Yakuhai[/cell]
[cell]Any Run[/cell][cell]0[/cell][cell]N/A[/cell]
[cell]Any Pair[/cell][cell]0[/cell][cell]2[/cell]
[cell]Open Set[/cell][cell]2[/cell][cell]4[/cell]
[cell]Closed Set[/cell][cell]4[/cell][cell]8[/cell]
[cell]Open Quad[/cell][cell]8[/cell][cell]16[/cell]
[cell]Closed Quad[/cell][cell]16[/cell][cell]32[/cell]
[/table]

[b]Waits[/b]
Fu awarded for your final wait. See Guide/Waits for more info.
[table=2]
[cell]1-sided[/cell][cell]2[/cell]
[cell]2-sided[/cell][cell]0[/cell]
[cell]>=3-sided[/cell][cell]0[/cell]
[/table]"

